{
  "name": "shopify-fast-storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A fast, accessible headless Shopify-style storefront on Next.js App Router with a swappable data adapter.",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "images": "node scripts/generate-images.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "lighthouse": "^13.5.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
