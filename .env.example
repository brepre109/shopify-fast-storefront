# Leave COMMERCE_ADAPTER unset (or "mock") to run on the bundled synthetic catalog.
# Set it to "storefront" to read from the Shopify Storefront API instead.
COMMERCE_ADAPTER=mock

# Storefront API (only read when COMMERCE_ADAPTER=storefront)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-public-storefront-access-token
SHOPIFY_STOREFRONT_API_VERSION=2025-07
